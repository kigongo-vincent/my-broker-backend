# HTTP port for Fiber (default 3001). Docker Compose sets PORT=3000 by default.
PORT=3001
# Force a specific env file and skip auto-discovery (path relative to process cwd or absolute).
# BACKEND_ENV_FILE=

DB_HOST=localhost
DB_PORT=5432
DB_USER=admin
DB_PASSWORD=admin
DB_NAME=my_broker
# libpq sslmode: disable | allow | prefer | require | verify-ca | verify-full
DB_SSLMODE=disable
# optional; for verify-ca / verify-full (e.g. path inside the container)
# DB_SSLROOTCERT=/app/certs/rds-ca.pem
JWT_SECRET=replace_me
CLOUDINARY_URL=
DB_SEED=false

# SMS: africastalking | sns (AWS SNS). Default credential chain: env keys, ~/.aws/credentials, or IAM role.
SMS_PROVIDER=africastalking
SMS_DRY_RUN=true
# Africa's Talking: use SMS_API_KEY (preferred) or legacy AT_API_KEY. AT_USERNAME is your app or "sandbox" username.
SMS_API_KEY=
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=
# Google Sign-In: web OAuth redirect (browser). Register redirect URI in Google Cloud → Web client.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_WEB_CLIENT_SECRET=
# Full callback URL, e.g. http://localhost:3001/auth/google/web/callback (must match Google Console).
GOOGLE_OAUTH_REDIRECT_URI=
# Where users land after login (Expo web), e.g. http://localhost:8081
WEB_APP_ORIGIN=
# Optional; used to derive GOOGLE_OAUTH_REDIRECT_URI if unset: {PUBLIC_API_URL}/auth/google/web/callback
PUBLIC_API_URL=http://localhost:3001
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
ADMIN_NAME=My Broker Admin
ADMIN_PHONE=0700000000
ADMIN_EMAIL=admin@mybroker.local
# SNS (when SMS_PROVIDER=sns)
AWS_REGION=
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY optional if using instance/container role

# S3 uploads (github.com/kigongo-vincent/my-broker-backend/s3storage). Wire NewFromEnv where you handle uploads.
AWS_S3_BUCKET=
# Public URL prefix for returned links (CloudFront or https://bucket.s3.region.amazonaws.com — omit path; keys are appended)
AWS_S3_PUBLIC_BASE_URL=
# AWS_S3_ENDPOINT=http://localhost:4566  # LocalStack / MinIO
# AWS_S3_USE_PATH_STYLE=true
