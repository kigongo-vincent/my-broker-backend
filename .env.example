DB_HOST=localhost
DB_PORT=5432
DB_USER=admin
DB_PASSWORD=admin
DB_NAME=my_broker
# libpq sslmode: disable | allow | prefer | require | verify-ca | verify-full
DB_SSLMODE=disable
# optional; for verify-ca / verify-full (e.g. path inside the container)
# DB_SSLROOTCERT=/app/certs/rds-ca.pem
JWT_SECRET=replace_me
CLOUDINARY_URL=
DB_SEED=false
SMS_PROVIDER=africastalking
SMS_DRY_RUN=true
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=
